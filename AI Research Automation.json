      "parameters": {
        "jsCode": "let combined = \"\";\n\nfor (const item of $input.all()) {\n  const q = item.json.query;\n  combined += `\\n\\n### Question: ${q}\\n`;\n  \n  const results = item.json.results || [];\n  for (const r of results) {\n    combined += `- ${r.title}: ${r.content}\\n`;\n  }\n}\n\nreturn [{ json: { research_data: combined } }];"
